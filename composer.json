{
  "name": "snowfire/beautymail",
  "description": "Send beautiful html emails with Laravel",
  "keywords": [
    "laravel",
    "html",
    "email"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Emil Sundberg",
      "email": "emil@snowfire.net"
    }
  ],
  "require": {
    "php": ">=8.2.0",
    "illuminate/support": "^9.0.0|^10.0.0|^11.0.0|^12.0.0|^13.0.0",
    "pelago/emogrifier": "^8.1"
  },
  "autoload": {
    "psr-0": {
      "Snowfire\\Beautymail\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "Snowfire\\Beautymail\\BeautymailServiceProvider"
      ]
    }
  }
}
